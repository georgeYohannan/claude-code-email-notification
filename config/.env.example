# ── Gmail ────────────────────────────────────────────────────────────────────
# Configure via n8n's built-in Gmail OAuth2 credential (no key needed here).
# The Gmail node in the workflow uses a credential named "Gmail OAuth2".

# ── myCase ───────────────────────────────────────────────────────────────────
MYCASE_API_TOKEN=your_mycase_api_token_here
MYCASE_BASE_URL=https://app.mycase.com/api/v1

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Scopes required: chat:write, im:write, channels:read, users:read

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Create a bot via @BotFather on Telegram, then paste the token above.

# ── n8n ───────────────────────────────────────────────────────────────────────
# Store the above secrets as n8n Credentials or environment variables
# in your n8n instance (Settings → Credentials).
# This file is for reference only — never commit real values.
